{
  "name": "school-management-saas",
  "version": "0.1.0",
  "private": false,
  "description": "Multi-tenant school management platform for Nigerian institutions: admissions, attendance, results, fees, payments, parent communication and administrative analytics.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "test:smoke": "node scripts/smoke-test.mjs",
    "test:smoke:local": "BASE_URL=http://localhost:3000 node scripts/smoke-test.mjs",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.106.2",
    "lucide-react": "^0.511.0",
    "next": "^16.2.6",
    "pdfkit": "^0.18.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "resend": "^4.5.1",
    "zod": "^3.25.36"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.1.8",
    "@types/node": "^22.15.29",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.28.0",
    "eslint-config-next": "^16.2.6",
    "tailwindcss": "^4.1.8",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^2.1.9"
  }
}
